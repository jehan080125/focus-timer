<Window x:Class="FocusTimer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FocusTimer" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}" Title="집중 타이머" Width="420" Height="480" MinWidth="380" MinHeight="480" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        PreviewKeyDown="Window_KeyDown" PreviewMouseDown="Window_PreviewMouseDown" MouseEnter="Window_HoverChanged" MouseLeave="Window_HoverChanged">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="15" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="local:TimeSegment">
      <Setter Property="Width" Value="56"/><Setter Property="Height" Value="64"/>
      <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/><Setter Property="FontSize" Value="42"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="SelectionOpacity" Value="0.16"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:TimeSegment">
        <Grid Background="Transparent">
          <Border x:Name="FocusSurface" CornerRadius="6" Background="{DynamicResource AccentBrush}" Opacity="0" Margin="0,6"/>
          <ScrollViewer x:Name="PART_ContentHost"/>
          <Border x:Name="FocusLine" Background="{DynamicResource AccentBrush}" Height="1" VerticalAlignment="Bottom" Margin="7,0,7,6" Opacity="0"/>
        </Grid>
        <ControlTemplate.Triggers>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsReadOnly" Value="False"/></MultiTrigger.Conditions><Setter TargetName="FocusSurface" Property="Opacity" Value="0.04"/></MultiTrigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsReadOnly" Value="False"/></MultiTrigger.Conditions><Setter TargetName="FocusLine" Property="Opacity" Value="0.6"/></MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="WindowRoot">
    <Border x:Name="BackgroundSurface" CornerRadius="15" Background="{DynamicResource SurfaceBrush}"/>
    <Grid x:Name="GlassDecoration" Visibility="Collapsed" IsHitTestVisible="False">
      <Image x:Name="GlassImage" Stretch="Fill"/>
    </Grid>
    <Border x:Name="WindowBorder" CornerRadius="15" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" IsHitTestVisible="False"/>
    <Grid x:Name="NormalContent" Margin="20,9,20,12">
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="56"/><RowDefinition Height="48"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="DragWindow">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE916;" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,0,9,0"/><TextBlock Text="집중 타이머" FontWeight="SemiBold"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="설정" AutomationProperties.Name="설정" Click="Settings_Click"/>
          <Button Style="{StaticResource IconButton}" Content="&#xEE47;" ToolTip="소형 모드" AutomationProperties.Name="소형 모드" Click="Mode_Click"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="최소화" AutomationProperties.Name="최소화" Click="Minimize_Click"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="닫기" AutomationProperties.Name="닫기" Click="Close_Click"/>
        </StackPanel>
      </Grid>
      <Viewbox Grid.Row="1" Margin="0,8,0,12" Stretch="Uniform" MouseLeftButtonDown="DragWindow">
        <Grid Width="244" Height="244">
          <local:Ring x:Name="ProgressRing" Accent="{DynamicResource AccentBrush}" Track="{DynamicResource TrackBrush}"/>
          <StackPanel x:Name="TimeInputs" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <local:TimeSegment x:Name="HoursInput" Text="00" Maximum="99" ToolTip="시 · 00–99" AutomationProperties.Name="시" TextChanged="TimeInput_Changed"/>
            <TextBlock Text=":" Width="12" FontFamily="{StaticResource AppFontFamily}" FontSize="42" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Center"/>
            <local:TimeSegment x:Name="MinutesInput" Text="25" Maximum="59" ToolTip="분 · 00–59" AutomationProperties.Name="분" TextChanged="TimeInput_Changed"/>
            <TextBlock Text=":" Width="12" FontFamily="{StaticResource AppFontFamily}" FontSize="42" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Center"/>
            <local:TimeSegment x:Name="SecondsInput" Text="00" Maximum="59" ToolTip="초 · 00–59" AutomationProperties.Name="초" TextChanged="TimeInput_Changed"/>
          </StackPanel>
        </Grid>
      </Viewbox>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Width="134" Height="38" Click="Play_Click" AutomationProperties.Name="시작 또는 일시정지"><StackPanel Orientation="Horizontal"><TextBlock x:Name="PlayIcon" FontFamily="Segoe Fluent Icons" Text="&#xE768;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="PlayText" Text="시작" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
        <Button Content="&#xE777;" FontFamily="Segoe Fluent Icons" Width="40" Height="38" Padding="0" Margin="8,0,0,0" ToolTip="초기화" AutomationProperties.Name="초기화" Click="Reset_Click"/>
      </StackPanel>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Content="다음 정시" FontSize="12" Click="Hour_Click" Margin="0,0,8,0"/>
        <Button x:Name="HalfHourButton" Content="다음 30분" ToolTip="다음 매시 30분까지" FontSize="12" Click="HalfHour_Click"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="MiniContent" Background="Transparent" Visibility="Collapsed" Margin="7" MouseLeftButtonDown="DragWindow">
      <Viewbox x:Name="MiniTimeBox" Margin="5,0" Stretch="Uniform"><TextBlock x:Name="MiniTimeLabel" Text="00:25:00" FontFamily="{StaticResource AppFontFamily}" FontSize="48" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/></Viewbox>
      <StackPanel x:Name="MiniToolbar" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Hidden">
        <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="FontSize" Value="12"/></Style></StackPanel.Resources>
        <Button x:Name="MiniPlayButton" Content="&#xE768;" ToolTip="시작 / 일시정지" AutomationProperties.Name="시작 또는 일시정지" Click="Play_Click"/>
        <Button x:Name="MiniResetButton" Content="&#xE777;" ToolTip="초기화" AutomationProperties.Name="초기화" Click="Reset_Click"/>
        <Button x:Name="PinButton" Content="&#xE718;" ToolTip="항상 위 표시" AutomationProperties.Name="항상 위 표시 전환" Click="Pin_Click"/>
        <Button x:Name="MiniNormalButton" Content="&#xEE49;" ToolTip="기본 모드" AutomationProperties.Name="기본 모드" Click="Mode_Click"/>
        <Button x:Name="MiniSettingsButton" Content="&#xE713;" ToolTip="설정" AutomationProperties.Name="설정" Click="Settings_Click"/>
        <Button x:Name="MiniCloseButton" Content="&#xE8BB;" ToolTip="닫기" AutomationProperties.Name="닫기" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>

