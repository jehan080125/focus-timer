<Window x:Class="FocusTimer.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="타이머 설정" Width="340" Height="340" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="DragWindow"><TextBlock Text="설정" FontSize="19" FontWeight="SemiBold"/><Button Content="라이선스" FontSize="11" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,36,0" Click="License_Click"/><Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="닫기" AutomationProperties.Name="설정 닫기" Click="Close_Click"/></Grid>
      <StackPanel Grid.Row="1" Margin="0,13,0,0">
        <CheckBox x:Name="GlassCheck" Content="리퀴드 글래스" Margin="0,0,0,12" Checked="Glass_Changed" Unchecked="Glass_Changed" ToolTip="소형 모드에서 유리 효과를 사용합니다. 화면 캡처·공유에서 타이머가 제외될 수 있습니다."/>
        <TextBlock x:Name="GlassStatus" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" Visibility="Collapsed"/>
        <DockPanel><TextBlock Text="글래스 프레임"/><TextBlock x:Name="FpsLabel" Text="60 fps" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
        <Slider x:Name="FpsSlider" Minimum="15" Maximum="144" Value="60" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="15" Margin="0,10,0,18" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="글래스 목표 프레임" ToolTip="15–144 fps · 높을수록 부드럽지만 전력 사용이 늘어납니다. 실제 프레임은 모니터와 PC 성능에 따라 달라집니다." ValueChanged="Fps_Changed"/>
        <DockPanel><TextBlock Text="배경 불투명도"/><TextBlock x:Name="OpacityLabel" Text="100%" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
        <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Value="100" TickFrequency="5" SmallChange="5" LargeChange="10" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="배경 불투명도" ValueChanged="Opacity_Changed"/>
        <CheckBox x:Name="NotifyCheck" Content="완료 알림" Margin="0,20,0,0" IsChecked="True" Checked="Notify_Changed" Unchecked="Notify_Changed"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
